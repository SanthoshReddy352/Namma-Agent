# Cognee container env — copy to ".env.cognee" (scripts/setup_cognee.* does this
# for you). Passed to the Cognee MCP container via --env-file.
#
# DEFAULT = FULLY LOCAL: Ollama serves BOTH the extraction LLM (qwen2.5:7b) and
# the embeddings (nomic-embed-text). No API key, no signup, nothing leaves your
# machine. Trade-off: graph building (cognify) is slow on CPU (~1–3 min per
# memory). For fast cloud extraction instead, see the alternatives at the bottom.
#
# Two URL gotchas (don't change them):
#   * LLM_ENDPOINT must end in /v1     (cognee POSTs {endpoint}/chat/completions)
#   * EMBEDDING_ENDPOINT must be the full /api/embed URL (cognee POSTs to it directly)

TRANSPORT_MODE=stdio

# ---- LLM (entity/relationship extraction + recall synthesis) = local Ollama ----
# qwen2.5:7b is the smallest local model that reliably produces cognee's
# structured JSON (3B models fail). The setup script pulls it for you.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_ENDPOINT=http://namma-cognee-ollama:11434/v1
LLM_API_KEY=ollama
LLM_MAX_TOKENS=8000

# ---- Embeddings = local Ollama (free) ----
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_ENDPOINT=http://namma-cognee-ollama:11434/api/embed
EMBEDDING_DIMENSIONS=768
HUGGINGFACE_TOKENIZER=nomic-ai/nomic-embed-text-v1.5

# ---- Storage: embedded files (local) ----
DB_PROVIDER=sqlite
VECTOR_DB_PROVIDER=lancedb
GRAPH_DATABASE_PROVIDER=kuzu

# ---- PERSISTENCE (so memory survives restarts) ----
# Write the graph/vector/sqlite DBs to the mounted volume (-v cognee-data:/cognee-data).
# These are the real cognee env names (BaseConfig data_root/system_root/cache_root).
# The setup script pre-creates these dirs with write perms (the volume is root-owned,
# Cognee runs non-root). Without this, Cognee writes inside the container → resets on restart.
DATA_ROOT_DIRECTORY=/cognee-data/data
SYSTEM_ROOT_DIRECTORY=/cognee-data/system
CACHE_ROOT_DIRECTORY=/cognee-data/cache

COGNEE_SKIP_CONNECTION_TEST=true
ENABLE_BACKEND_ACCESS_CONTROL=false

# ===========================================================================
# FASTER ALTERNATIVES (cloud extraction; embeddings stay free/local).
# Replace ONLY the LLM block above with one of these — or just pick a preset in
# Settings → MCP → Cognee → Models & embeddings (no file editing needed).
#
# Groq (free tier, very fast — key from https://console.groq.com):
#   LLM_PROVIDER=custom
#   LLM_MODEL=groq/llama-3.3-70b-versatile
#   LLM_ENDPOINT=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#
# OpenAI:
#   LLM_PROVIDER=openai
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_ENDPOINT=
#   LLM_API_KEY=sk-...
#
# Any OpenAI-compatible endpoint (OpenCode Zen, Together, LM Studio, …):
#   LLM_PROVIDER=custom
#   LLM_MODEL=openai/<model-id>
#   LLM_ENDPOINT=https://<host>/v1
#   LLM_API_KEY=<key>
